# Copy to .env for local dev (not committed). In production this is set via
# Railway's dashboard/CLI, wired to the project's Redis plugin's reference
# variable (e.g. REDIS_URL=${{Redis.REDIS_URL}}).

# Required for the desktop's content to persist across restarts -- without
# this, the server logs a warning and runs with no persistence at all.
REDIS_URL=

# Comma-separated allowlist of Google account emails permitted to sign in.
# Access is invite-only -- there's no open signup. Unset means nobody can
# sign in (fails closed). Matching is case-insensitive.
ALLOWED_EMAILS=

# Required for Google sign-in and for the Google Doc destination. From a
# single Google Cloud OAuth 2.0 Client ID (type: Web application) -- see
# docs/CURRENT-WORK.md's manual setup steps. Both redirect URIs below must be
# registered on that one client. Also needs REDIS_URL above, since OAuth
# tokens and sessions are stored in Redis.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Connect Google as a send destination" (Drive/Docs scopes):
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/connect/google/callback
# "Sign in with Google" (identity scopes only):
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8787/auth/login/google/callback

# Required for the Dropbox file destination. From an app registered at
# https://www.dropbox.com/developers/apps (Scoped access, Full Dropbox); the
# redirect URI below must be registered on that app. Also needs REDIS_URL.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:8787/auth/connect/dropbox/callback

# Optional overrides (sensible defaults exist for local dev):
# PORT=8787
# CLIENT_DIST_DIR=../client/dist
