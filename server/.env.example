# Copy to .env for local dev (not committed). In production these are set
# as Fly secrets: fly secrets set UPSTASH_REDIS_REST_URL=... UPSTASH_REDIS_REST_TOKEN=...

# Required for the desktop's content to persist across restarts -- without
# these, the server logs a warning and runs with no persistence at all.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional overrides (sensible defaults exist for local dev):
# PORT=8787
# CLIENT_DIST_DIR=../client/dist
