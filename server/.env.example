# Copy to .env for local dev (not committed). In production this is set via
# Railway's dashboard/CLI, wired to the project's Redis plugin's reference
# variable (e.g. REDIS_URL=${{Redis.REDIS_URL}}).

# Required for the desktop's content to persist across restarts -- without
# this, the server logs a warning and runs with no persistence at all.
REDIS_URL=

# Required both for "Sign in with Google" (login) and the Google Doc
# destination (connect Google, then select text -> send to a Google Doc) --
# from the same Google Cloud OAuth 2.0 Client ID (type: Web application), but
# note these are two separate OAuth round-trips with two separate callback
# routes, so both redirect URIs below need registering with Google. See
# docs/CURRENT-WORK.md's manual setup steps. Also needs REDIS_URL above set,
# since sessions/tokens are stored in Redis.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/connect/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8787/auth/login/google/callback

# Required to sign in at all: a comma-separated allowlist of emails permitted
# to use this deployment (invite-only -- see docs/REQUIREMENTS.md's
# Auth/Identity section). Anyone else's Google sign-in is rejected.
ALLOWED_EMAILS=

# Optional overrides (sensible defaults exist for local dev):
# PORT=8787
# CLIENT_DIST_DIR=../client/dist
