# Copy to .env for local dev (not committed). In production this is set via
# Railway's dashboard/CLI, wired to the project's Redis plugin's reference
# variable (e.g. REDIS_URL=${{Redis.REDIS_URL}}).

# Required for the desktop's content to persist across restarts -- without
# this, the server logs a warning and runs with no persistence at all.
REDIS_URL=

# Required for the Google Doc destination (select text -> send to a Google
# Doc). From a Google Cloud OAuth 2.0 Client ID (type: Web application) --
# see docs/CURRENT-WORK.md's manual setup steps. Also needs REDIS_URL above
# set, since the OAuth tokens are stored in Redis.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Optional overrides (sensible defaults exist for local dev):
# PORT=8787
# CLIENT_DIST_DIR=../client/dist
