{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "skipLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // Tests are not part of the production build (`npm run build` -> Docker /
  // Railway). They're type-checked separately via tsconfig.test.json +
  // `npm run typecheck`, run in CI -- a type error in a test must not fail
  // the deploy.
  "exclude": ["src/**/*.test.ts"]
}
